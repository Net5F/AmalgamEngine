/**
 * This is an example UserConfig.json file, these values are not actually used. 
 * Projects can reference this file to understand what fields they must 
 * provide in their UserConfig.json.
 */

{
  // AccountServer's IP address and service port.
  "accountServerIP": "127.0.0.1",
  "accountServerPort": 41497,

  // ChatServer's IP address and service port.
  "chatServerIP": "127.0.0.1",
  "chatServerPort": 41495,

  // The maximum number of clients that we will allow at once.
  "maxClients": 1000
}
